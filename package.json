{
  "name": "interview-calendar",
  "version": "1.0.0",
  "description": "秋招管家 - QQ邮箱面试邮件自动解析 + 日历管理 + 投递记录",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/king-wwwhhh/FRM-Fall-Recruitment-Manager.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/run-all.js",
    "smoke": "electron smoke.js",
    "deep-scan": "node deep-scan.js",
    "test-parse": "node test-parse.js",
    "tls-diag": "node tls-diag.js",
    "verify-ui": "electron verify-ui.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish=always"
  },
  "author": "king",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.1"
  },
  "build": {
    "appId": "com.king.frm",
    "productName": "秋招管家",
    "copyright": "Copyright © 2026 king",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "config.example.json",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "${productName}-Setup.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "artifactName": "${productName}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
